# Copy to .env and fill in. Do NOT commit .env.

# Strong random token (>=16 chars). The connector must send: Authorization: Bearer <this>
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# GitHub read token if Johnsonbros/248-arena is private (fine-grained, contents:read).
GIT_TOKEN=

# OPTIONAL — enables the read-only stripe_* tools. Use a RESTRICTED key, not your
# full secret key: Dashboard → Developers → API keys → Create restricted key, with
# read-only access to Payment Links, Prices, Products, Subscriptions, Charges.
STRIPE_KEY=

# OPTIONAL — enables the arena_business_* / arena_pulse_* / arena_scholarship_* /
# arena_question_reports tools (the autonomous-agent surface). ACCESS_ADMIN_KEY is
# the SAME value as REPORTS_KEY in arena-access's .env. ACCESS_API is the internal
# docker-network address of arena-access (default is right if both share a network).
ACCESS_API=http://arena-access:8766
ACCESS_ADMIN_KEY=

# Usually leave these as-is:
MCP_PORT=8765
APP_DIR=/mnt/user/appdata/248-arena
REPO_SLUG=Johnsonbros/248-arena
DEFAULT_BRANCH=main
CONTAINER_NAME=arena248
ARENA_PORT=8248
