# Copy to .env and fill in. Do NOT commit .env.

# RESTRICTED Stripe key (Dashboard → Developers → API keys → Create restricted key).
# Needs READ on: Checkout Sessions, Customers, Subscriptions. Nothing else.
STRIPE_KEY=

# Webhook signing secret for the endpoint you create in Stripe
# (Developers → Webhooks → Add endpoint → https://arena-api.248arena.com/webhook).
STRIPE_WEBHOOK_SECRET=

# CORS origin allowed to call the /api endpoints (the app itself).
SITE_ORIGIN=https://248arena.com

# --- Magic-link sign-in (optional but recommended) ---------------------------
# Resend.com API key (free tier). Until set, /api/login returns 501 and the app
# falls back to plain email unlock.
RESEND_API_KEY=
MAIL_FROM=248 Arena <noreply@248arena.com>
APP_URL=https://248arena.com

# --- Owner admin key -----------------------------------------------------------
# One long random key gates ALL owner endpoints:
#   question reports:     GET  /api/reports?key=...
#   fun benchmark:        GET  /api/pulse-summary?key=...
#   scholarship minting:  POST /api/scholarship/mint {key, count, months, note}
#   scholarship ledger:   GET  /api/scholarship/list?key=...
# (see LAUNCH.md "Scholarship seats" + "The fun benchmark")
REPORTS_KEY=

# Usually leave as-is:
PORT=8766
DATA_FILE=/data/access.json
