# Copy to .env and fill in. Do NOT commit .env.

# RESTRICTED Stripe key (Dashboard → Developers → API keys → Create restricted key).
# Needs READ on: Checkout Sessions, Customers, Subscriptions. Nothing else.
STRIPE_KEY=

# Webhook signing secret for the endpoint you create in Stripe
# (Developers → Webhooks → Add endpoint → https://arena-api.thejohnsonbros.com/webhook).
STRIPE_WEBHOOK_SECRET=

# CORS origin allowed to call the /api endpoints (the app itself).
SITE_ORIGIN=https://arena.thejohnsonbros.com

# Usually leave as-is:
PORT=8766
DATA_FILE=/data/access.json
