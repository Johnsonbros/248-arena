# Copy to .env and adjust. Do NOT commit .env.

# OpenAI-compatible chat endpoint on your fleet. Known-good candidates on AiSync:
#   http://ai-router-controller:4000/v1/chat/completions   (same docker network only)
#   http://host.docker.internal:4000/v1/chat/completions   (works whenever the port is published — the reliable default)
#   http://<AiSync-LAN-IP>:4000/v1/chat/completions
LLM_URL=http://ai-router-controller:4000/v1/chat/completions

# LOCAL model — the 3090 workhorse. Handles the large majority of tutoring at
# $0 per call. Model name as your gateway knows it (LiteLLM route or ollama/<model>).
LLM_MODEL=ollama/llama3.1

# --- Tiered routing (optional) ----------------------------------------------
# PREMIUM model: used ONLY for hard turns (calculations, "why", comparisons,
# long/multi-part questions, challenges), designated workflows, and one retry
# when a local answer looks weak. Leave PREMIUM_MODEL empty to stay 100% local.
# Route it through the same gateway (LiteLLM) or point at another endpoint.
PREMIUM_MODEL=
PREMIUM_URL=
PREMIUM_KEY=
# Hard cap on paid calls per hour — the ceiling on your API spend.
PREMIUM_PER_HOUR=20

# Bearer key if your gateway requires one (LiteLLM master key). Leave empty if not.
LLM_KEY=

# arena-access service (gates chat to active subscribers; fail-closed).
ACCESS_URL=http://arena-access:8766

# --- Voice loop (phase 2) — both already run on the AiSync fleet -------------
# Same network rule as LLM_URL: if 'whisper'/'kokoro-tts' don't resolve, use
# http://host.docker.internal:<published-port>/... instead.
# faster-whisper-server (container 'whisper', CUDA) — OpenAI-compatible STT.
STT_URL=http://whisper:8000/v1/audio/transcriptions
STT_MODEL=Systran/faster-whisper-base.en
# kokoro-fastapi (container 'kokoro-tts') — OpenAI-compatible TTS.
TTS_URL=http://kokoro-tts:8880/v1/audio/speech
TTS_VOICE=am_adam
TTS_MODEL=kokoro

# CORS origin allowed to call this service.
SITE_ORIGIN=https://248arena.com

# Usually leave as-is:
PORT=8767
RATE_PER_USER_HOUR=40
RATE_GLOBAL_HOUR=300
